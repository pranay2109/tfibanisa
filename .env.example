# Copy to .env.local for local development.

# Postgres. Local: docker compose up -d. Production: Neon pooled connection string.
DATABASE_URL=postgres://tfibanisa:tfibanisa@localhost:5433/tfibanisa

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Google login (optional locally; the button is hidden when these are empty).
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email. When RESEND_API_KEY is empty, the link is printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="TFI Banisa <login@tfibanisa.app>"
